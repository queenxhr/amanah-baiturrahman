@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam class {
    BackgroundColor white
    ArrowColor Black
    BorderColor Black
}

' --- INTERFACE OBJECT (Layer 1) ---

interface "PenggunaAuth <<interface>>" as PenggunaAuth {
    - email: budi@email.com
    - password: ******************
    + login()
    + logout()
    + lupaPassword()
}

' --- ACTOR OBJECTS (Layer 2) ---

class "SuperadminHendra : Superadmin" as SuperadminHendra {
    - id_user: 99
    - id_role: 3
    - nama: "Bapak Hendra"
    - email_verified_at: "2026-07-10 08:00:00"
    + kelolaNazhirApprove()
    + kelolaNazhirReject()
    + blockUser()
    + unblockUser()
    + hapusAkunUser()
    + verifikasiProgram()
    + verifikasiPencairanDana()
}

class "NazhirAhmad : Nazhir" as NazhirAhmad {
    - id_user: 1
    - id_role: 1
    - nama: "Ustadz Ahmad"
    - status: "active"
    - email_verified_at: "2026-07-10 12:00:00"
    + lihatDashboardLaporan()
    + lihatDashboardEksporCSV()
    + verifikasiTransaksi()
    + kelolaDataAkunUser()
    + kelolaProgramLaporan()
    + ajukanPencairanDana()
}

class "WakifBudi : Wakif" as WakifBudi {
    - id_user: 12
    - id_role: 2
    - nama: "Budi Santoso"
    - no_hp: "081234567890"
    - jenis_kelamin: 'L'
    - alamat: "Jl. Baiturrahman No. 5, Padalarang"
    - tanggal_lahir: 1990-05-14
